---
/**
 * ApiFieldList — a titled, anchored property group (params, request body, schema
 * fields, response fields). Renders a list of `ApiFieldRow`s, or slotted content
 * (the body-union explorer) when `fields` is omitted. The Expand/Collapse toggle
 * is wired by one delegated listener that flips every `<details>` in the group.
 * `title` is optional — omit it where an ancestor already names the group (e.g. a
 * response body under its status), so the badge/controls stand alone.
 */
import { cn } from "@/lib/cn";
import ApiFieldRow from "./ApiFieldRow.astro";
import { isExpandable } from "./type-display";
import type { ApiFieldView } from "@cloudflare/nimbus-docs/api";

interface Props {
  /** Group heading. Omit when an ancestor already labels the group. */
  title?: string;
  fields?: ApiFieldView[];
  anchor?: string;
  /** Heading level, so the group sits correctly under its page/section. */
  as?: "h2" | "h3" | "h4";
  /** A small pill beside the title — e.g. the body media type (`JSON`). */
  badge?: string;
  /** Force the Expand/Collapse-all controls (for slotted, non-`fields` content). */
  collapsible?: boolean;
  /** Present when the engine capped this list at the inline-field ceiling; keeps
   *  the "N omitted" note in parity with the markdown twin. Non-firing on real
   *  specs (the ceiling sits above the largest observed page). */
  truncated?: { total: number };
  class?: string;
}

const { title, fields, anchor, as = "h3", badge, collapsible, truncated, class: className } = Astro.props;
// Title-less groups drop to a plain span so the badge/controls carry no heading.
const HeadTag = title ? as : "span";

const hasFields = fields !== undefined;
const empty = hasFields && fields!.length === 0;
const showControls = collapsible ?? (hasFields && fields!.some(isExpandable));
const omitted = truncated && hasFields ? truncated.total - fields!.length : 0;
const hasHead = Boolean(title) || Boolean(badge) || showControls;
---

{
  !empty && (
    <section id={anchor} class={cn("scroll-mt-24", className)} data-api-section>
      {hasHead && (
        <div class="mb-2 flex items-center justify-between gap-3">
          <HeadTag class="flex items-center gap-2 text-sm font-normal text-muted-foreground">
            {title}
            {badge && (
              <span class="inline-flex items-center gap-1 rounded border border-border px-1.5 py-0.5 font-mono text-[0.6875rem] text-muted-foreground">
                <span aria-hidden="true">{"{}"}</span>
                {badge}
              </span>
            )}
          </HeadTag>
          {showControls && (
            <button
              type="button"
              data-api-toggle-all
              data-expanded="false"
              class="group/toggle flex items-center gap-1 text-xs text-muted-foreground transition-colors hover:text-foreground"
            >
              <span class="group-data-[expanded=true]/toggle:hidden">Expand</span>
              <span class="hidden group-data-[expanded=true]/toggle:inline">Collapse</span>
              <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m7 15 5 5 5-5" />
                <path d="m7 9 5-5 5 5" />
              </svg>
            </button>
          )}
        </div>
      )}
      {hasFields ? (
        <ul class="list-none p-0">
          {fields!.map((field: ApiFieldView) => (
            <ApiFieldRow field={field} />
          ))}
          {omitted > 0 && (
            <li class="py-1.5 text-xs text-muted-foreground">… {omitted} more field(s) omitted</li>
          )}
        </ul>
      ) : (
        <slot />
      )}
    </section>
  )
}

<script>
  document.addEventListener("click", (event) => {
    const target = event.target as HTMLElement | null;
    const button = target?.closest<HTMLElement>("[data-api-toggle-all]");
    if (!button) return;
    const section = button.closest<HTMLElement>("[data-api-section]");
    if (!section) return;
    const open = button.dataset.expanded !== "true";
    section.querySelectorAll("details").forEach((d) => {
      d.open = open;
    });
    button.dataset.expanded = String(open);
  });
</script>
