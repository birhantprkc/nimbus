---
/**
 * ApiFieldRow — one `ApiFieldView`, rendered recursively. A leaf renders its
 * signature inline; an object/union field renders a disclosure (native
 * `<details>`) whose content is its nested children or, for a union field, the
 * variant explorer. Display formatting lives in `type-display.ts`. Anchored by
 * the field's stable id so the page can deep-link a property.
 */
import ApiPropertyMeta from "./ApiPropertyMeta.astro";
import ApiUnionExplorer from "./ApiUnionExplorer.astro";
import { isExpandable } from "./type-display";
import type { ApiFieldView } from "@cloudflare/nimbus-docs/api";

interface Props {
  field: ApiFieldView;
}

const { field } = Astro.props;

const expandable = isExpandable(field);
const omitted = field.childCount - field.children.length;
---

<li id={field.anchor} class="group/row scroll-mt-24 py-1.5">
  {
    expandable ? (
      <details class="group/exp">
        <summary class="flex list-none cursor-pointer items-start gap-2 [&::-webkit-details-marker]:hidden">
          <span
            class="mt-1 flex size-4 shrink-0 items-center justify-center text-muted-foreground transition-colors group-hover/exp:text-foreground"
            aria-hidden="true"
          >
            <svg class="size-3.5 group-open/exp:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14" />
              <path d="M12 5v14" />
            </svg>
            <svg class="hidden size-3.5 group-open/exp:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14" />
            </svg>
          </span>
          <ApiPropertyMeta field={field} interactive={false} />
        </summary>
        <div class="mt-1 ml-2 border-l border-border pl-4">
          {field.union ? (
            <ApiUnionExplorer union={field.union} />
          ) : (
            <ul class="list-none p-0">
              {field.children.map((child) => (
                <Astro.self field={child} />
              ))}
              {/* Only fires when a container hits the inline-field ceiling — a safety net, never a normal spec. */}
              {field.truncated && (
                <li class="py-1.5 text-xs text-muted-foreground">… {omitted} more field(s) omitted</li>
              )}
            </ul>
          )}
        </div>
      </details>
    ) : (
      <div class="flex items-start gap-2">
        <span class="mt-1 size-4 shrink-0" aria-hidden="true" />
        <ApiPropertyMeta field={field} />
      </div>
    )
  }
</li>
