---
/**
 * Nimbus Icon component — drop-in replacement for `astro-icon`'s `<Icon>`.
 *
 * Renders SVG icons from:
 *   - Local `src/icons/*.svg` files (referenced by bare name, e.g. `name="workers"`)
 *   - Iconify-packaged icon sets (referenced by `set:name`, e.g. `name="ph:x"` for Phosphor)
 *
 * The icon data is loaded at build time via the `virtual:nimbus/icons`
 * Vite plugin (provided by the Nimbus integration). No `lastModified`
 * timestamp is emitted into the virtual module, so Astro's incremental
 * build cache treats it as stable across builds.
 *
 * API-compatible with `astro-icon`'s `<Icon>`:
 *   - `name` (required): icon name, with or without set prefix
 *   - `size`: shorthand for `width` + `height`
 *   - `width`, `height`: override dimensions
 *   - `is:inline`: accepted for compatibility; SVGs are always inlined
 *   - `title`, `desc`: accessibility attributes
 *   - All other props forwarded to `<svg>`
 */
// @ts-expect-error virtual module
import icons from "virtual:nimbus/icons";
// @ts-expect-error generated by typegen
import type { Icon } from "virtual:nimbus/icons";
import { getIconData, iconToSVG } from "@iconify/utils";
import type { HTMLAttributes } from "astro/types";
import type { IconifyIconBuildResult } from "@iconify/utils/lib/svg/build.js";

interface Props extends HTMLAttributes<"svg"> {
  name: Icon | string;
  "is:inline"?: boolean;
  title?: string;
  desc?: string;
  size?: number | string;
  width?: number | string;
  height?: number | string;
}

const { name = "", title, desc, "is:inline": _inline, ...props } = Astro.props;

let [setName, iconName] = (name as string).split(":");

if (!setName && iconName) {
  const err = new Error(`Invalid "name" provided!`);
  (err as Error & { hint?: string }).hint =
    `The provided value of "${name}" is invalid. Did you forget the icon set name? If you were attempting to reference a local icon, use the icon's name directly. (ie. "${iconName}")`;
  throw err;
}

// No iconName → assume local icon reference
if (!iconName) {
  iconName = setName;
  setName = "local";
  if (!icons[setName]) {
    throw new Error('Unable to load the "local" icon set!');
  }
  if (!(iconName in icons[setName].icons)) {
    throw new Error(`Unable to locate "${name}" icon!`);
  }
}

const collection = icons[setName];
if (!collection) {
  throw new Error(`Unable to locate the "${setName}" icon set!`);
}

const iconData = getIconData(collection, iconName ?? setName);
if (!iconData) {
  throw new Error(`Unable to locate "${name}" icon!`);
}

if (props.size) {
  props.width = props.size;
  props.height = props.size;
  delete props.size;
}

const renderData = iconToSVG(iconData);
const normalizedProps = {
  ...renderData.attributes as Partial<IconifyIconBuildResult["attributes"]>,
  ...props,
};
const normalizedBody = renderData.body;
---

<svg {...normalizedProps} data-icon={name}>
  {title && <title>{title}</title>}
  {desc && <desc>{desc}</desc>}
  <Fragment set:html={normalizedBody} />
</svg>

